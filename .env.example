# PRIMARY (68.183.247.78 — 4 vCPU/7.8GB, isolated Docker Postgres+pgvector
# stack behind its own TLS+SCRAM+fail2ban port). Use this by default.
DATABASE_URL=postgresql://nextjs_app_user:YOUR_PASSWORD@68.183.247.78:48219/nextjs_app

# SECONDARY (168.144.92.215 — smaller shared box, extends its existing
# native Postgres cluster via a hardened PgBouncer endpoint). Switch to
# this by commenting out the DATABASE_URL above and uncommenting this one:
# DATABASE_URL=postgresql://nextjs_app:YOUR_PASSWORD@168.144.92.215:39217/nextjs_main

# Both endpoints: TLS required, works the same from local dev, Vercel, or
# anywhere else — no SSH tunnel needed for either.
#
# Deliberately no ?sslmode=require on either URL above: lib/db/client.ts
# already passes `ssl: { rejectUnauthorized: false }` to the pg Pool
# (required since both certs are self-signed). Adding sslmode=require to
# the URL on top of that conflicts with node-postgres's ssl handling and
# the connection fails with "self-signed certificate". Tools without their
# own ssl override (psql, etc.) should still add ?sslmode=require when
# connecting directly.
#
# Direct-to-Postgres alternative for the secondary server only (bypasses
# PgBouncer, private network only):
# npm run db:tunnel
# then use: postgresql://nextjs_app:YOUR_PASSWORD@127.0.0.1:5433/nextjs_main?sslmode=require

# /admin (blog content manager) — single shared admin password + a secret
# used only to sign the session cookie (HMAC-SHA256, no session store, no
# new dependency). Generate a fresh secret with: openssl rand -hex 32
ADMIN_PASSWORD=YOUR_ADMIN_PASSWORD
ADMIN_SESSION_SECRET=YOUR_RANDOM_HEX_SECRET
